# --- LLM credentials (set ONE of these; never commit the real .env) ---------
# Testing phase: Gemini (free tier) — create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Production: Claude
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ------------------------------------
# Provider: auto | gemini | anthropic ("auto" = whichever key is present)
TALENTFLOW_PROVIDER=auto
# Empty = provider default (gemini-2.5-flash / claude-opus-4-8)
TALENTFLOW_MODEL=
TALENTFLOW_MAX_TOKENS=4096
TALENTFLOW_CHECKPOINT_DB=talentflow_checkpoints.sqlite
TALENTFLOW_RANDOM_SEED=42
